# SentinelZero AI service -- example only. Copy to .env and fill values.
# NEVER commit a real .env or a real NVIDIA key. Only server-side variables.

# --- Runtime ---------------------------------------------------------------
AI_ENVIRONMENT=development
AI_LOG_LEVEL=INFO
AI_ENABLE_DOCS=true

# --- Caller authentication (HS256 demo / shared service JWT) --------------
# At least 32 random bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_JWT_SECRET=replace-with-a-long-random-secret
AI_JWT_ALGORITHM=HS256
AI_JWT_ISSUER=sentinelzero-auth
AI_JWT_AUDIENCE=sentinelzero-ai
AI_JWT_LEEWAY_SECONDS=30

# Optional RS256 public key (PEM, use \n for newlines) instead of HS256.
# AI_JWT_PUBLIC_KEY=

# --- NVIDIA Nemotron -------------------------------------------------------
# Verified endpoint: OpenAI-compatible POST {base}/chat/completions
AI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Keep server-side. Never use a VITE_ variable for this.
NVIDIA_API_KEY=nvapi-replace-me
AI_NVIDIA_TIMEOUT_SECONDS=45
AI_NVIDIA_CONNECT_TIMEOUT_SECONDS=10
AI_NVIDIA_MAX_RETRIES=2
AI_NVIDIA_MAX_OUTPUT_TOKENS=2048
AI_NVIDIA_TEMPERATURE=0.1
AI_NVIDIA_TOP_P=0.9

# Use only for tests/demo. Never in production; health and runs label it SIMULATED.
AI_PROVIDER_MODE=live

# --- Incident backend (Agent 1/SpacetimeDB bridge) ------------------------
# memory = local simulator state file (MOCK contract, EXERCISE only)
# http   = Agent 1 service contract documented in docs/deployment.md
AI_BACKEND_MODE=memory
AI_BACKEND_BASE_URL=http://127.0.0.1:3000
AI_BACKEND_SERVICE_TOKEN=replace-with-service-token
AI_BACKEND_TIMEOUT_SECONDS=10
AI_SIMULATOR_STATE_PATH=../../simulator/.state/state.json

# --- Bounds ---------------------------------------------------------------
AI_MAX_STEPS=6
AI_MAX_TOOL_CALLS=10
AI_MAX_TOOL_RESULT_CHARS=20000
AI_MAX_CONTEXT_CHARS=32000
AI_RUN_DEADLINE_SECONDS=90
AI_REQUIRE_TOOL_ROUND_TRIP=true
AI_MAX_BODY_BYTES=16384
AI_MAX_CONCURRENT_RUNS_PER_USER=2
AI_RATE_LIMIT_PER_MINUTE=6
AI_RATE_LIMIT_BURST=2
AI_RUN_TTL_SECONDS=3600
AI_MAX_STORED_RUNS=500

# --- CORS (JSON array; leave empty for server-to-server only) -------------
AI_CORS_ORIGINS=[]
