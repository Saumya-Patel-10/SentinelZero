# SentinelZero environment template. PLACEHOLDERS ONLY: copy to .env (git-ignored) and fill locally.
# Never commit real tokens or keys. See docs/INTEGRATION_CONTRACT.md section 6.

# --- SpacetimeDB (backend) ---
STDB_URI=http://127.0.0.1:3000
STDB_DB_NAME=sentinelzero

# --- Web (apps/web, exposed to the browser: no secrets here) ---
VITE_STDB_URI=http://127.0.0.1:3000
VITE_STDB_DB_NAME=sentinelzero
# Dedicated out-of-band OIDC tenant. The client id is registered with add_trusted_audience.
VITE_OIDC_ISSUER=https://idp.example.invalid/realms/sentinelzero
VITE_OIDC_CLIENT_ID=sentinelzero-web

# --- AI service (services/ai; names follow its AI_-prefixed settings) ---
AI_BACKEND_MODE=http
AI_BACKEND_BASE_URL=http://127.0.0.1:3000
# Service-principal token from POST /v1/identity, registered by an OWNER with register_service_principal.
AI_BACKEND_SERVICE_TOKEN=<secret: service-principal token>
AI_NVIDIA_API_KEY=<secret: NVIDIA API key>

# --- Tooling (scripts and tests) ---
SPACETIME_CLI=spacetime
SZ_STDB_URI=http://127.0.0.1:3000
SZ_DB=sentinelzero
SZ_ADMIN_TOKEN=<secret: platform-admin token, only for seed-demo without --publish>
