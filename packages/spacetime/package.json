{
  "name": "@sentinelzero/spacetime",
  "version": "1.0.0",
  "private": true,
  "description": "SentinelZero SpacetimeDB operational backend module (TypeScript)",
  "type": "module",
  "scripts": {
    "build": "spacetime build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "generate": "spacetime generate --lang typescript --out-dir ./bindings --module-path . --yes",
    "publish:local": "spacetime publish sentinelzero --server local --delete-data=always --yes",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "spacetimedb": "2.14.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.6.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
